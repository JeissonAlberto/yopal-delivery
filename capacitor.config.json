{
  "appId": "com.lupinexpress.client",
  "appName": "LUPIN Express",
  "webDir": "public",
  "bundledWebRuntime": false,
  "server": {
    "url": "http://10.0.2.2:3000/client/",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#090D16"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#090D16",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}

{
  "appId": "com.lupinexpress.driver",
  "appName": "LUPIN Repartidor",
  "webDir": "public",
  "bundledWebRuntime": false,
  "server": {
    "url": "http://10.0.2.2:3000/driver/?demo=true",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#090D16"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#090D16",
      "showSpinner": false
    },
    "Geolocation": {
      "enableHighAccuracy": true
    },
    "KeepAwake": {
      "keepAwake": true
    }
  }
}

# ============================================================================
# LUPIN EXPRESS - VARIABLES DE ENTORNO PARA PRODUCCIÓN (VPS)
# ============================================================================

# Puerto del Servidor
PORT=3000
NODE_ENV=production

# Clave Secreta para Tokens JWT (Generar una cadena aleatoria de 64 caracteres)
JWT_SECRET=lupin_express_yopal_casanare_secure_production_key_2026_jwt_secret

# URL de Conexión a Base de Datos PostgreSQL con PostGIS
DATABASE_URL=postgres://lupin_admin:lupin_secure_db_pass_2026@localhost:5432/lupin_delivery_db

# URL de Conexión a Redis para Pub/Sub y Telemetría GPS
REDIS_URL=redis://localhost:6379

# Dominio Público de Producción
DOMAIN_NAME=delivery.tudominio.com

# Pasarela de Pagos (Wompi / Bold en Colombia - Opcional para pruebas)
WOMPI_PUBLIC_KEY=pub_prod_XXXXXXXXXXXXXX
WOMPI_PRIVATE_KEY=prv_prod_XXXXXXXXXXXXXX
WOMPI_INTEGRITY_SECRET=prod_integrity_XXXXXXXXXXXXXX
